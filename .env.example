# PulseLink — environment configuration (demo runs entirely offline).
# Copy to `.env` and adjust. The demo defaults select the offline/mock providers.

# ---------------------------------------------------------------------------
# Provider selection seam (Requirements 12.2, 12.3)
# These flags let the messaging channel, voice channel, and LLM client be
# swapped between offline mocks (demo) and real providers (production) WITHOUT
# changing business logic.
# ---------------------------------------------------------------------------

# LLM client provider (Requirement 12.3)
#   mock    -> deterministic offline MockLlmClient (demo default)
#   bedrock -> Amazon Bedrock (Anthropic Claude Haiku) in production
LLM_PROVIDER=mock

# Message channel provider (Requirement 12.2)
#   mock     -> offline MockChannel, no app install (demo default)
#   sms      -> real SMS provider (e.g. Amazon SNS) in production
#   whatsapp -> real WhatsApp Business provider in production
#   voice    -> PulseLink Voice VoiceChannel (Amazon Connect + Lex/Transcribe + Polly + SNS)
MESSAGE_CHANNEL=mock

# Voice channel provider (PulseLink Voice — Requirements 12.2, 13.x)
#   mock    -> MockVoiceChannel (plays generated audio locally, simulates DTMF/voice intent)
#   connect -> Amazon Connect + Lex/Transcribe + Polly + SNS in production
VOICE_PROVIDER=mock

# Event bus provider
#   memory      -> in-memory event bus (demo default)
#   eventbridge -> Amazon EventBridge in production
EVENT_BUS=memory

# Default language used when a donor has no recorded preferred_lang
# (Requirements 9.2, 13.3)
DEFAULT_LANG=en

# Low-confidence review threshold for the Parser (Requirement 5.3)
PARSE_REVIEW_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Data store (local PostgreSQL + PostGIS for the demo;
# maps to RDS db.t3.micro in the budget production profile)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://pulselink:pulselink@localhost:5432/pulselink

# Local symmetric encryption stand-in for Contact_Point values
# (maps to AWS KMS in production — Requirement 7.3). Demo-only key.
CONTACT_ENCRYPTION_KEY=change-me-demo-only-32byte-key!!

# ---------------------------------------------------------------------------
# Seed source (local filesystem for the demo; maps to S3 import in production)
# ---------------------------------------------------------------------------
DATASET_CSV_PATH=./Dataset.csv

# ---------------------------------------------------------------------------
# Amazon Bedrock (used only when LLM_PROVIDER=bedrock; the offline demo uses
# the MockLlmClient and never reads these). Defaults select Anthropic Claude
# Haiku for cost efficiency.
# ---------------------------------------------------------------------------
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Twilio — real voice IVR + WhatsApp (leave blank to use simulated mode)
# ---------------------------------------------------------------------------

# Get these from https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number (makes outbound calls)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# WhatsApp sender — Twilio Sandbox default (free dev/demo):
#   Both test numbers must join by texting "join <word>" to +1 415 523 8886
# For production replace with your approved WhatsApp Business number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Webhook base URL — must be publicly reachable by Twilio.
# For local dev: install ngrok, run `ngrok http 8000`, paste the https URL here.
WEBHOOK_BASE_URL=https://<your-ngrok-id>.ngrok-free.app

# Test phone numbers for the demo flow
# All IVR calls go to TWILIO_TEST_DONOR_PHONE (press 1/2/3 then 1/2 on your phone)
# WhatsApp notifications go to TWILIO_COORDINATOR_PHONE
TWILIO_TEST_DONOR_PHONE=+91xxxxxxxxxx
TWILIO_COORDINATOR_PHONE=+91xxxxxxxxxx
